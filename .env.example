# Jira Report Generator - 配置模板
# Make a copy as .env and fill in your values.
#
# ============================================================
# Jira 认证 (Jira Credentials)
# ============================================================
JIRA_USERNAME=your-email@example.com
JIRA_PASSWORD=your-password

# ============================================================
# AI 提供商 - 配置 (Provider)
# ============================================================
# 可选值: deepseek | openai | anthropic | custom
AI_PROVIDER=deepseek
# 接入模式: official (官方直连) | third_party (第三方代理/网关)
AI_API_MODE=official

# ============================================================
# API 密钥 - 官方接入配置 (Official API Keys)
# ============================================================
# 各厂商原生接入的 API Key，填入对应厂商官方分配的密钥即可
# DeepSeek  官方: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key
# OpenAI   官方: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
# Anthropic 官方: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# 自定义兼容接口 (OpenAI-compatible)
CUSTOM_API_KEY=

# ============================================================
# 模型与端点 - 官方接入配置 (Model & Endpoint)
# ============================================================
AI_MODEL=deepseek-chat
# 自定义 API 端点 (仅 AI_PROVIDER=custom 时必须填写)
CUSTOM_ENDPOINT=

# ============================================================
# 第三方 / Claude Code 兼容配置 (Third-party Proxy)
# ============================================================
# 说明: 以下字段用于通过第三方网关/代理接入 AI 服务，命名与
# Claude Code 的 .claude/settings.json 中 "env" 块保持一致。
# 当下方值被填写时，自动映射到上方对应的官方配置项:
#   ANTHROPIC_AUTH_TOKEN          → ANTHROPIC_API_KEY
#   DEEPSEEK_AUTH_TOKEN           → DEEPSEEK_API_KEY
#   OPENAI_AUTH_TOKEN             → OPENAI_API_KEY
#   ANTHROPIC_BASE_URL            → CUSTOM_ENDPOINT
#   OPENAI_BASE_URL               → CUSTOM_ENDPOINT
#   ANTHROPIC_MODEL               → AI_MODEL
#   ANTHROPIC_DEFAULT_SONNET_MODEL→ AI_MODEL
#   ANTHROPIC_DEFAULT_OPUS_MODEL  → AI_MODEL
#   ANTHROPIC_DEFAULT_HAIKU_MODEL → AI_MODEL
#   CLAUDE_CODE_SUBAGENT_MODEL    → AI_MODEL
# 注意: 官方配置项已填写时，官方配置优先

# --- 认证令牌 (替代上方的 API_KEYS) ---
ANTHROPIC_AUTH_TOKEN=
DEEPSEEK_AUTH_TOKEN=
OPENAI_AUTH_TOKEN=

# --- 第三方 API 端点 (替代上方的 CUSTOM_ENDPOINT) ---
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# --- 模型选择 (替代上方的 AI_MODEL; 按从上到下优先级取第一个) ---
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=

# --- 其他 Claude Code 兼容项 ---
CLAUDE_CODE_EFFORT_LEVEL=

# ============================================================
# 报表格式 (Report Formatting)
# ============================================================
## 1=Issue Key, 2=Customer, 3=Project/Model, 4=Status, 5=Description, 6=Key Issue, 7=Progress
COLUMN_ORDER=1,2,3,4,5,6,7
KEY_ISSUE_HIGHLIGHT=true
COMMENT_TIMESTAMP_PREFIX=false
THEME=Geek
LANGUAGE=zh

# ============================================================
# 其他 (Other)
# ============================================================
LAST_SAVE_DIR=~/Downloads
